{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Genesis Grid",
    "version": "3.5.0"
  },
  "tauri": {
    "allowlist": {
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://**",
          "https://**"
        ]
      },
      "shell": {
        "open": true
      },
      "fs": {
        "all": true,
        "scope": [
          "$APPDATA/genesis-grid/*"
        ]
      },
      "dialog": {
        "all": true
      },
      "process": {
        "all": true,
        "relaunch": true
      },
      "app": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.genesisgridlabs.app",
      "copyright": "© 2026 Genesis Grid Labs™. All Rights Reserved.",
      "publisher": "Genesis Grid Labs",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": [
        "nsis",
        "msi",
        "dmg",
        "appimage",
        "rpm",
        "deb"
      ],
      "shortDescription": "A one-click local AI desktop",
      "longDescription": "Genesis Grid is a one-click local AI desktop that manages Ollama models, features an autonomous micro-agent swarm, and provides a fully private workflow."
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Genesis Grid",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    }
  }
}
